@page
@model IndexModel
@{
    ViewData["Title"] = "Cities List";
}

<div class="text-center">
    <h1 class="display-4">Cities of the World</h1>
    <p>This list is retrieved from an MSSQL Database.</p>
</div>

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <table class="table table-striped table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>ID</th>
                    <th>City Name</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var city in Model.Cities)
                {
                    <tr>
                        <td>@city.Id</td>
                        <td>@city.Name</td>
                    </tr>
                }
            </tbody>
        </table>
        
        @if (!Model.Cities.Any())
        {
            <div class="alert alert-info">
                No cities found in the database.
            </div>
        }
    </div>
</div>
